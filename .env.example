# Backend API — MUST end with /exec (auto-appended if you forget)
#
# Local dev:
#   VITE_API_URL=http://localhost:4000/exec
#
# Vercel production (recommended — same origin, no CORS / mixed-content issues):
#   1. Set VITE_API_URL=/exec in Vercel → Settings → Environment Variables
#   2. Update frontend/vercel.json "destination" to your GCP backend URL
#   3. Redeploy
#
# Direct to GCP (requires HTTPS backend + CORS_ORIGINS on server):
#   VITE_API_URL=https://your-api.example.com/exec
VITE_API_URL=http://localhost:4000/exec

VITE_ADMIN_PASS=8031
VITE_ATTEND_PASS=8031
